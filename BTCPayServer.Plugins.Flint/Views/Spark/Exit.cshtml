@using BTCPayServer.Plugins.Flint.Data
@model SparkExitViewModel
@{
    // No nav entry of its own. A unilateral exit is the last thing a store should ever need, so it is reached
    // from the Advanced page and keeps that entry lit rather than advertising itself in the sidebar.
    ViewData.SetLayoutModel(new LayoutModel(SparkNavPages.Advanced, "Unilateral exit").SetCategory(SparkNavCategory.Id));

    // A trail back through the section, so the heading is not the only entry in it. Without one, TitleHeader
    // synthesises a single crumb equal to the title and prints the heading twice.
    BTCPayServer.ViewDataDictionaryExtensions.SetBreadcrumbs(ViewData,
        new BTCPayServer.Components.Breadcrumb.BreadcrumbItem("Flint", Action: "Status",
            Controller: "Spark", RouteValues: new { storeId = Model.StoreId }),
        new BTCPayServer.Components.Breadcrumb.BreadcrumbItem("Advanced", Action: "Advanced",
            Controller: "Spark", RouteValues: new { storeId = Model.StoreId }));

    var record = Model.ActiveRecord;

    // Labels as local functions rather than inline switch expressions, so the markup below stays readable and
    // the wording for each state lives in one place.
    static string DescribeStatus(UnilateralExitStatus status) => status switch
    {
        UnilateralExitStatus.AwaitingFunding => "Quoted — waiting for your funding",
        UnilateralExitStatus.Built => "Built and signed — waiting for you to broadcast",
        UnilateralExitStatus.Completed => "Completed",
        _ => "Abandoned"
    };

    // The label is what tells an operator which of the instructions further down apply to a row, so the kind
    // this page does not recognise gets a label that says so rather than the sweep's. Falling through to "Sweep"
    // would hand a transaction nobody here understands the sweep's instructions — alone and last — which is
    // advice about a shape the page has not established.
    static string DescribeKind(SparkExitTxKind kind) => kind switch
    {
        SparkExitTxKind.Fanout => "Fan-out",
        SparkExitTxKind.TreeNode => "Tree node",
        SparkExitTxKind.Refund => "Refund",
        SparkExitTxKind.Sweep => "Sweep",
        // Not a step in the exit: one transaction per leaf the operators already moved on-chain, co-signed by
        // them, paying its own fee out of the value it recovers. No CPFP child, no timelock, nothing to wait for.
        SparkExitTxKind.Cooperative => "Cooperative recovery",
        _ => "Unrecognised kind"
    };

    // The SDK's 0.25 status is a union, not a flat enum, because the useful question stopped being "is it
    // mined" and became "may I broadcast it yet". So this says the action, not the state: an operator reading
    // "Not confirmed" beside a transaction the chain service could not see would reasonably go looking for a
    // node. Each readiness gets its own wording and none of them fall through to a generic one — "waiting" and
    // "unverified" both mean "do not send this yet" but the next step is different in each case.
    static string DescribeTxStatus(SparkExitTxStatus status) => status.Readiness switch
    {
        SparkExitTxReadiness.Ready => "Ready — broadcast it now",
        // Naming the height is what turns "wait" into a number. Without it the operator has nothing to do but
        // reload the page, and a page that only ever says "wait" is one people stop opening.
        SparkExitTxReadiness.Waiting when status.SpendableAtHeight is { } spendableAt
            => $"Waiting — valid from block {spendableAt.ToString("N0")}",
        SparkExitTxReadiness.Waiting
            => "Waiting — a transaction it depends on has not confirmed",
        SparkExitTxReadiness.Confirmed when status.BlockHeight is { } blockHeight
            => $"Confirmed in block {blockHeight.ToString("N0")} — nothing left to do",
        SparkExitTxReadiness.Confirmed => "Confirmed — nothing left to do",
        _ => "Unverified — no chain service answered"
    };

    // The one place the submitpackage-versus-sendrawtransaction decision is made. A tree transaction pays no
    // fee of its own, so submitting it alone is rejected — which is why this is a decision and not a format
    // string. It is a local function called from both the "send these now" list and the full table, so the two
    // cannot disagree about which command a given row needs: a merchant who ran one command from the summary
    // and a different one from the table would be right to stop trusting both.
    //
    // The hex is checked again here although the service already refuses a set that is not hex, because this is
    // the line that turns a database string into something an operator pastes into a shell. Hex cannot carry a
    // quote or a semicolon; anything else is not a transaction and does not get a command.
    //
    // A cooperative recovery is deliberately not a case of its own: it pays its own fee out of the value it
    // recovers and has no child, so it lands in the plain sendrawtransaction branch, which is exactly right —
    // and, unlike the packages, it does not need a node that accepts them.
    static string BroadcastCommand(SparkExitTransaction tx) =>
        !SparkExitTransaction.IsTransactionHex(tx.TxHex)
        || (tx.CpfpTxHex is not null && !SparkExitTransaction.IsTransactionHex(tx.CpfpTxHex))
            ? "(no command: this stored transaction is not valid hex, so it is not shown as one)"
            : tx.CpfpTxHex is { } cpfpTxHex
                ? $"bitcoin-cli submitpackage '[\"{tx.TxHex}\",\"{cpfpTxHex}\"]'"
                : $"bitcoin-cli sendrawtransaction {tx.TxHex}";

    // The explorer form appears in two of this page's states — before anything is quoted, and beside the
    // funding panel — and never in both at once, so one local function serves both without colliding ids.
    // Off mainnet it is not a preference: mempool.space has no regtest or testnet, so funding discovery
    // refuses outright until this is set, and the form says so rather than sitting there looking optional.
    //
    // Server administrators only: the URL makes this server send requests to a host of the setter's choosing on
    // every page view, so it is a server setting in all but location. Everyone else sees what is set and whom to
    // ask, rather than a form that would be refused.
    async Task ExplorerForm()
    {
        <div not-permission="@Policies.CanModifyServerSettings" class="mb-3" id="SparkExitExplorerReadOnly">
            <span class="form-label d-block">Block explorer API</span>
            <code>@(Model.EsploraApiUrl is { Length: > 0 } configured ? configured : SparkExitFundingExplorer.MainnetDefaultApiUrl + " (default)")</code>
            <div class="form-text">
                Only a server administrator can change which block explorer this server asks about exit funding,
                because it decides which host the server sends requests to.
            </div>
        </div>
        <form method="post" asp-action="SetExitExplorer" asp-route-storeId="@Model.StoreId"
              permission="@Policies.CanModifyServerSettings" id="SparkExitExplorerForm"
              class="@(Model.IsMainnet ? "mb-3" : "alert alert-warning mb-3")">
            <label asp-for="EsploraApiUrl" class="form-label">Block explorer API</label>
            <div class="input-group">
                <input asp-for="EsploraApiUrl" class="form-control font-monospace" id="SparkExitExplorerUrl"
                       placeholder="@SparkExitFundingExplorer.MainnetDefaultApiUrl" />
                <button type="submit" class="btn btn-outline-secondary" id="SparkExitExplorerSave">Save</button>
            </div>
            <div class="form-text">
                @if (Model.IsMainnet)
                {
                    <text>
                        An esplora API, asked only while you use this page: for a suggested fee rate beside the
                        quote form, and for what has arrived on the funding address while an exit waits for
                        funding and when it is built. Left empty it is
                        <code>@SparkExitFundingExplorer.MainnetDefaultApiUrl</code>, which means telling
                        mempool.space which address funds your exit; point it at your own instance if you would
                        rather not. Its answer decides which funding outputs a build spends, but it cannot
                        redirect money: the destination is yours and every signature commits to the amount it
                        spends, so a wrong answer can only make a build refuse or fail.
                    </text>
                }
                else
                {
                    <text>
                        <strong>Required on @Model.NetworkName.</strong> There is no public esplora for this
                        network, so without one Flint cannot tell you whether your funding has arrived — the build
                        itself will refuse rather than guess. Point this at your own esplora, for example
                        <code>http://localhost:3002/api</code>. Saving it empty clears it again.
                    </text>
                }
            </div>
        </form>
    }
}

<div class="sticky-header">
    <vc:title-header />
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">

        @if (Model.LoadError is { } loadError)
        {
            @*
                The read failed, so nothing below is known — including whether an exit is in progress. Rendering
                the quote form here would say "no exit is in progress" on the strength of a query that never
                answered, so the page says only what it knows.
            *@
            <div class="alert alert-danger" role="alert" id="SparkExitLoadError">@loadError</div>
        }
        else
        {
        @if (!Model.WalletRunning)
        {
            <div class="alert alert-danger" role="alert" id="SparkExitWalletStopped">
                This store's Spark wallet is not running, so nothing here can be quoted, built or checked
                against the chain. Any exit already built is still shown below — broadcasting its signed
                transactions does not need the wallet, but refreshing their statuses does.
            </div>
        }

        @if (!Model.DisclosureAcknowledged)
        {
            @*
                The disclosure comes before anything else on the page, and there is deliberately no balance, no
                fee field and no address input above it. A merchant who lands here is usually alarmed about
                something; the first thing they should learn is that this is almost certainly not the tool they
                want.
            *@
            <h3 class="mb-3">Before you use this</h3>
            <div class="alert alert-danger" role="alert" id="SparkExitDisclosure">
                <p>
                    <strong>A unilateral exit is a last resort.</strong> It is how you get this store's balance
                    on-chain when Spark's operators will not cooperate — a normal sweep is a cooperative exit,
                    costs a flat fee, and lands in seconds. Use that unless it has stopped working.
                </p>
                <p>
                    <strong>You need your own Bitcoin, on-chain, first.</strong> The exit tree pays no fees of
                    its own; you fund it from a separate on-chain UTXO before anything can be built. Every
                    transaction you broadcast spends part of that funding on its fee, and that part is gone
                    whether or not the exit completes. Funding for an exit you never broadcast is not spent —
                    it stays on the funding address, recoverable from this store's recovery phrase — and
                    whatever a finished exit did not spend on fees is swept to your destination with the
                    recovered coins.
                </p>
                <p>
                    <strong>It takes days, not minutes.</strong> Each level of the tree carries a CSV timelock,
                    so the transactions become valid one level at a time, with a wait between each.
                </p>
                <p>
                    <strong>This plugin never broadcasts any of it — you do.</strong> Flint builds and signs the
                    transactions and stops there. Getting them confirmed is manual work on a Bitcoin node you
                    control, in a specific order, over those days.
                </p>
                <p>
                    <strong>It works without Spark's operators only if you prepared for it.</strong> An exit is
                    quoted and built from data the SDK holds on this server, so it does not need the operators
                    to be reachable — but only for leaves whose data was collected while they still were. That
                    is what the exit-state backup on the Advanced page is for: collect it before you need it,
                    and an exit built from it goes ahead with the operators gone for good.
                </p>
                <p class="mb-0">
                    <strong>Nothing about it is covered by the guarantees the rest of the plugin makes.</strong>
                    Whether it finishes depends on exit data collected earlier, on a Bitcoin node you run, and on
                    you broadcasting each step in order and on time — and a mistake in any of those is yours to
                    recover from.
                </p>
            </div>

            <form method="post" asp-action="AcknowledgeExit" asp-route-storeId="@Model.StoreId"
                  permission="@Policies.CanModifyStoreSettings">
                <div class="form-check mb-3">
                    @*
                        The checkbox is friction, not the gate. What gates quoting is the stored acknowledgement
                        this post creates — the service refuses to quote without it, on this surface and on any
                        other — so the box is `required` for the merchant's benefit and the server does not read
                        it. Nothing here is a permission a form could grant itself.
                    *@
                    <input type="checkbox" class="form-check-input" id="SparkExitDisclosureConfirm" required />
                    <label class="form-check-label" for="SparkExitDisclosureConfirm">
                        I have read the above. I understand I will fund this myself, broadcast it myself, and wait
                        days for it to complete.
                    </label>
                </div>
                <button type="submit" class="btn btn-danger" id="SparkExitAcknowledge">
                    I understand — let me quote an exit
                </button>
            </form>
        }
        else if (record is null)
        {
            @*
                Acknowledged, nothing in flight: the only thing to do here is price one. The balance is context
                rather than an input — the quote decides for itself which leaves are worth exiting at the rate
                asked for, and it can quite legitimately come back with none of them.
            *@
            <h3 class="mb-3">Quote an exit</h3>

            <table class="table table-sm">
                <tbody>
                    <tr>
                        <th class="w-50">Spark balance</th>
                        <td id="SparkExitBalance">@Model.BalanceSats.ToString("N0") sats</td>
                    </tr>
                </tbody>
            </table>

            <form method="post" asp-action="QuoteExit" asp-route-storeId="@Model.StoreId"
                  permission="@Policies.CanModifyStoreSettings" id="SparkExitQuoteForm">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="FeeRateSatPerVbyte" class="form-label"></label>
                        <div class="input-group">
                            @*
                                min/max are a courtesy: the service holds the real bounds and refuses anything
                                outside them, on this surface and on the API. They are read off the service's own
                                constants rather than typed in, so the browser and the server cannot disagree
                                about what will be accepted.
                            *@
                            <input asp-for="FeeRateSatPerVbyte" type="number"
                                   min="@SparkUnilateralExitService.MinFeeRateSatPerVbyte"
                                   max="@SparkUnilateralExitService.MaxFeeRateSatPerVbyte" step="1"
                                   class="form-control" id="SparkExitFeeRate" />
                            <span class="input-group-text">sat/vB</span>
                        </div>
                        <span asp-validation-for="FeeRateSatPerVbyte" class="text-danger"></span>
                        <div class="form-text">
                            Set the fee rate to use for the entire exit chain. Be sure to set it higher than
                            the current mempool minimum, as it will be used for the entire exit chain over the
                            course of several hours or even days.
                            @if (Model.FeeRateSuggested)
                            {
                                @*
                                    Whose number it is, said out loud: a third party's claim about the fee market,
                                    capped so a broken or hostile explorer cannot make the most expensive exit the
                                    default.
                                *@
                                <span class="d-block mt-1" id="SparkExitFeeRateSuggested">
                                    Pre-filled with the block explorer's half-hour estimate, capped at
                                    @SparkExitFundingExplorer.MaxRecommendedFeeRateSatPerVbyte.ToString("N0") sat/vB.
                                    It is a suggestion, not a check — look at the mempool yourself before quoting.
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="DestinationAddress" class="form-label"></label>
                    <input asp-for="DestinationAddress" class="form-control font-monospace"
                           id="SparkExitDestination" />
                    <span asp-validation-for="DestinationAddress" class="text-danger"></span>
                    <div class="form-text">
                        The address your funds will end up in. Please be sure to choose an address you have
                        proper access to, as changing this address after starting the exit will be costly!
                    </div>
                </div>

                <button type="submit" class="btn btn-primary" id="SparkExitQuote">Quote an exit</button>
            </form>

            @if (!Model.IsMainnet || Model.EsploraApiUrl is { Length: > 0 })
            {
                @*
                    Offered before there is anything to fund, because off mainnet this is the difference between
                    a funding panel that reports what has arrived and one that can only shrug. On mainnet it
                    appears only when somebody has already set it, so an operator can see and change what they
                    chose without the page pushing a knob nobody needs.
                *@
                <h3 class="mt-5 mb-3">Funding discovery</h3>
                await ExplorerForm();
            }
        }
        else
        {
            @if (record.LastError is { } lastError)
            {
                @*
                    Left on the record rather than cleared on read, so an exit that is still awaiting funding
                    carries the reason it has not been built. Warning rather than danger: the usual cause is a
                    funding shortfall, which is a step outstanding, not a failure.
                *@
                <div class="alert alert-warning" role="alert" id="SparkExitLastError">
                    <strong>The last attempt on this exit did not get through.</strong>
                    <span class="d-block mt-1">@lastError</span>
                </div>
            }

            @*
                What an active exit depends on, and what the plugin can and cannot keep from undoing it. The exit is
                pinned to named leaves; anything that spends or reshapes one makes the next build refuse. Flint's
                own sweep is paused (the engine refuses with its own recorded reason), and the rest is said
                plainly because it cannot be paused from here.
            *@
            <div class="alert alert-warning" role="alert" id="SparkExitLeavesAtRisk">
                <strong>While this exit is in progress, keep this store's balance still.</strong> Flint pauses its
                own sweeps for this store — automatic and manual — because a sweep would spend the leaves this exit
                is pinned to. It cannot pause everything: Lightning payments out of this wallet, payouts, Stable
                Balance conversions and Spark's own background leaf optimisation keep running and can spend or
                reshape those leaves. If that happens, building refuses rather than quietly building a smaller exit
                from the same funding, and you will have to abandon this exit and quote a new one.
            </div>

            <h3 class="mb-3">This exit</h3>
            <table class="table" id="SparkExitSummary">
                <tbody>
                    <tr>
                        <th class="w-50">Status</th>
                        <td id="SparkExitStatus">@DescribeStatus(record.Status)</td>
                    </tr>
                    <tr>
                        <th>Recoverable</th>
                        <td>
                            @record.RecoverableValueSat.ToString("N0") sats
                            <div class="form-text">
                                @if (record.RequiresFunding)
                                {
                                    <text>
                                        The value of the leaves being exited. Most of the fee below — the fan-out and
                                        the fee-bumping children — is paid from your funding, not from this; only the
                                        final sweep's own fee comes out of it. What arrives at the destination is
                                        this, less the sweep's fee, plus whatever funding the exit did not spend.
                                    </text>
                                }
                                else
                                {
                                    @*
                                        Nothing was funded, so the split between "your Bitcoin" and "the recovered
                                        value" above has no second half. Left unsplit, an operator would read that
                                        sentence looking for the funding this exit never asked for.
                                    *@
                                    <text>
                                        The value of the leaves being recovered. Each recovery in this set pays its
                                        own fee out of the value it recovers, so what arrives at the destination is
                                        this, less the fee below.
                                    </text>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th>Total fee</th>
                        <td>
                            @record.TotalFeeSat.ToString("N0") sats at @record.FeeRateSatPerVbyte.ToString("N0") sat/vB
                            <div class="form-text">
                                @if (record.RequiresFunding)
                                {
                                    <text>
                                        Everything the exit pays miners, across your funding and the recovered value
                                        together. It is not taken from the recoverable amount twice: recoverable
                                        minus this is not what arrives.
                                    </text>
                                }
                                else
                                {
                                    <text>
                                        Everything this recovery pays miners, taken out of the value it recovers as
                                        each transaction goes out. It is taken once: what arrives at the destination
                                        is the recoverable amount less this.
                                    </text>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <th>Funding required</th>
                        <td>
                            @if (!record.RequiresFunding)
                            {
                                @*
                                    Zero is a real answer here, not a requirement of nothing: every leaf is being
                                    recovered cooperatively, so each transaction pays its own fee out of the value
                                    it recovers. Printing "0 sats in a single UTXO" would put a figure in front of
                                    an operator who is meant to send nothing, and they would either wait for a
                                    number that never comes or send dust at it.
                                *@
                                <strong>None — nothing needs funding</strong>
                                <div class="form-text">
                                    Every leaf this exit recovers was already moved on-chain by the Spark
                                    operators, so each recovery pays its own fee out of the value it recovers. No
                                    Bitcoin of yours is spent and the funding address is not used by this exit.
                                </div>
                            }
                            else if (record.Status is UnilateralExitStatus.AwaitingFunding)
                            {
                                <strong>@record.SingleUtxoFundingSat.ToString("N0") sats in a single UTXO</strong>
                                <div class="form-text">
                                    One output of at least this size. <strong>Two outputs adding up to it do not
                                    work</strong> for the first build — it is priced for, and spends, one funding
                                    output, so a split deposit comes up short.
                                </div>
                            }
                            else
                            {
                                @*
                                    After a build the single-output rule no longer applies: a rebuild hands Spark
                                    the funding already committed to follow, plus anything else on the address.
                                *@
                                <strong>Committed to this exit</strong>
                                <div class="form-text">
                                    The funding this set was built from. Building again hands it back to Spark,
                                    which follows it to whatever the broadcast transactions turned it into, and adds
                                    anything else on the funding address — so if a rebuild asks for more, a top-up
                                    of any size counts.
                                </div>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Leaves</th>
                        <td>
                            @if (Model.LeafCount is { } leaves)
                            {
                                <span>@leaves.ToString("N0")</span>
                                <div class="form-text">
                                    Pinned when this was quoted. The build prices these exact leaves again rather
                                    than re-selecting, so what you funded stays what gets built.
                                </div>
                            }
                            else
                            {
                                @* The service reads this column; a blank here means it could not. *@
                                <span class="text-warning">Not readable from this record</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Destination</th>
                        <td><code class="text-break">@record.DestinationAddress</code></td>
                    </tr>
                    <tr>
                        <th>Funding address</th>
                        <td>
                            <vc:truncate-center text="@record.FundingAddress" classes="truncate-center-id" />
                            @if (Model.FundingKeyPath is { Length: > 0 } keyPath)
                            {
                                @*
                                    The one string that makes this address recoverable without Flint. If the exit
                                    is abandoned, or this server is gone, funding left sitting here is reachable
                                    from the store's recovery phrase at this path and nowhere else — no wallet
                                    finds it by scanning, because the account is deliberately not a standard one.
                                    Shown for every state of an active record, not only while funding is awaited,
                                    because the moment it matters most is after something has gone wrong.
                                *@
                                <div class="form-text">
                                    Derivation path <code id="SparkExitFundingKeyPath">@keyPath</code> — keep this
                                    with your recovery phrase to be able to reclaim unspent funding by hand.
                                </div>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th>Quoted</th>
                        <td>@record.CreatedUtc.ToString("u")</td>
                    </tr>
                </tbody>
            </table>

            @if (record.Status is UnilateralExitStatus.AwaitingFunding)
            {
                @if (record.RequiresFunding)
                {
                    <h3 class="mt-5 mb-3">Fund it</h3>
                    <p>
                        Send <strong>@record.SingleUtxoFundingSat.ToString("N0") sats</strong> to the address below
                        as <strong>one single output</strong>, from any wallet you control. This is your own Bitcoin
                        paying the exit's on-chain fees; it is not part of the balance being recovered. The amount
                        carries some headroom, and whatever the exit does not spend on fees is swept to your
                        destination at the end together with the recovered coins.
                    </p>
                    <div class="input-group mb-2">
                        <input id="SparkExitFundingAddress" type="text" class="form-control font-monospace"
                               readonly="readonly" value="@record.FundingAddress" />
                        <button type="button" class="btn btn-outline-secondary"
                                data-clipboard-target="#SparkExitFundingAddress">
                            Copy
                        </button>
                    </div>
                    <div class="form-text mb-3">
                        Derived from this store's recovery phrase on a path of the plugin's own, so it is not an
                        address any other wallet will show you. Send only the funding here — it is not a deposit
                        address and nothing sent to it reaches the Spark balance.
                    </div>

                    <table class="table table-sm">
                        <tbody>
                            <tr>
                                <th class="w-50">
                                    Largest single output
                                    <div class="form-text">
                                        What the build is actually judged by.
                                    </div>
                                </th>
                                <td id="SparkExitFundingLargest">
                                    @if (Model.FundingLargestOutputSat is { } largest)
                                    {
                                        <span>@largest.ToString("N0") sats</span>
                                        @if (largest < record.SingleUtxoFundingSat)
                                        {
                                            @*
                                                The shortfall is judged here and not on the total, because the
                                                total can be comfortably over the requirement while every
                                                individual output is under it — and in that state the build
                                                refuses. A hint that read "you have enough" beside a refusal is
                                                worse than no hint.
                                            *@
                                            <div class="form-text">
                                                Short of the @record.SingleUtxoFundingSat.ToString("N0") sats this
                                                exit needs in <strong>one</strong> output. Adding a second payment
                                                does not combine with the first: send the full
                                                @record.SingleUtxoFundingSat.ToString("N0") sats again as one new
                                                output, and the earlier one stays yours to spend back out.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="form-text">
                                                Enough to build with. The build re-checks it against a fresh quote
                                                before signing anything.
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-warning">Unknown</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Received in total</th>
                                <td id="SparkExitFundingReceived">
                                    @if (Model.FundingReceivedSat is { } received)
                                    {
                                        <span>@received.ToString("N0") sats</span>
                                        <div class="form-text">
                                            Everything confirmed on the address, across however many payments. This
                                            figure does not decide anything — one output has to cover the whole
                                            requirement on its own, because the fee-bumping transaction spends a
                                            single outpoint.
                                        </div>
                                    }
                                    else
                                    {
                                        @*
                                            Explicitly not "0 sats". Nobody knows, and a merchant who read this as
                                            "my funding has not arrived" would send it twice.
                                        *@
                                        <span class="text-warning">
                                            Unknown — the block explorer could not be reached
                                        </span>
                                        <div class="form-text">
                                            This is not the same as zero, and it does not stop you: check the
                                            address in any explorer yourself, or set one below and reload. The
                                            build looks the funding up again itself and refuses rather than
                                            half-building.
                                        </div>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    @if (Model.FundingReceivedSat is null || !Model.IsMainnet || Model.EsploraApiUrl is { Length: > 0 })
                    {
                        await ExplorerForm();
                    }
                }
                else
                {
                    @*
                        A recovery can need nothing of the operator's: since SDK 0.28 every leaf in it can be
                        cooperative, meaning the operators already moved those leaves on-chain and co-sign one
                        transaction per leaf that pays its own fee. There is then no amount to send and no address
                        to send it to, so the whole funding panel is replaced rather than rendered around a zero —
                        a requirement of 0 sat is not something an operator can satisfy, and an address beside it
                        would invite a deposit this exit never spends.
                    *@
                    <h3 class="mt-5 mb-3">Nothing to fund</h3>
                    <p>
                        Spark already holds every leaf this exit recovers on-chain, so it is recovered
                        cooperatively: one transaction per leaf, each paying its own fee out of the value it
                        recovers. No funding is needed, the funding address is not used, and nothing is spent from
                        your own Bitcoin.
                    </p>
                }

                <form method="post" asp-action="BuildExit" asp-route-storeId="@Model.StoreId"
                      permission="@Policies.CanModifyStoreSettings">
                    <input type="hidden" name="recordId" value="@record.Id" />
                    <button type="submit" class="btn btn-primary" id="SparkExitBuild">
                        Build and sign the exit
                    </button>
                    <div class="form-text">
                        @if (record.RequiresFunding)
                        {
                            <text>
                                Finds the funding, prices this exit's leaves again, and signs the transactions.
                                <strong>It broadcasts nothing.</strong> If the funding is short, nothing is signed
                                and you can send more and press this again.
                            </text>
                        }
                        else
                        {
                            <text>
                                Prices this exit's leaves again and signs each recovery. <strong>It broadcasts
                                nothing</strong>, and there is no funding to find first, so nothing stands between
                                this and a signed set.
                            </text>
                        }
                    </div>
                </form>
            }
            else if (record.Status is UnilateralExitStatus.Built)
            {
                <h3 class="mt-5 mb-3">Broadcast it yourself</h3>

                @if (Model.CheckResult is { } verdict)
                {
                    @*
                        The three verdicts are not a scale of severity — they are three different next actions,
                        which is why each gets its own copy rather than a shared banner with a varying colour.
                        In particular Redo is an error that must not read like a loss: the chain moved out from
                        under the stored transactions, and the money is still there to be recovered by building
                        again. The word "abandon" is deliberately absent.
                    *@
                    @if (verdict is SparkExitVerdict.Done)
                    {
                        <div class="alert alert-success" role="alert" id="SparkExitCheckDone">
                            <strong>This exit is finished.</strong> Every transaction has confirmed, the sweep
                            included, so the money is at your destination address. Mark it completed below and
                            this store can quote another exit.
                        </div>
                    }
                    else if (verdict is SparkExitVerdict.Redo)
                    {
                        <div class="alert alert-danger" role="alert" id="SparkExitCheckRedo">
                            <strong>This set of transactions can no longer finish.</strong> Something on-chain has
                            stopped matching them, so broadcasting the rest will not complete this exit.
                            <strong>Your money is not lost</strong> — a new exit built from the same leaves
                            recovers it. Press <em>Build again</em> below and the plugin re-reads the chain and
                            signs a fresh set; anything already confirmed is skipped rather than rebuilt. It pays
                            for that from the funding this exit already committed, which Spark follows to wherever
                            it went — you only need to send more if the rebuild says it is short.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert" id="SparkExitCheckValid">
                            <strong>This exit is on track.</strong>
                            @if (Model.PendingBroadcast is { Count: > 0 } readyCount)
                            {
                                <span>@readyCount.Count.ToString("N0") of its transactions can be broadcast
                                right now; they are listed beside the table below.</span>
                            }
                            else
                            {
                                <span>Nothing can be broadcast at this moment — every step is either already
                                confirmed or still waiting on one that is.</span>
                            }
                            The statuses in the table have been refreshed from the chain and stored, so what you
                            see below is current rather than what the exit looked like when it was built.
                        </div>
                    }
                }

                <div class="alert alert-danger" role="alert">
                    <strong>These transactions exist nowhere but this page and this server's database.</strong>
                    Nothing has broadcast them and nothing will. Copy them somewhere safe before you start.
                </div>

                @*
                    When the statuses below were last read from the chain. Nothing refreshes them between a build
                    or a check — no background task watches an exit — so a "Ready" from yesterday reads exactly
                    like one from a minute ago unless the page says which it is.
                *@
                <p class="text-secondary" id="SparkExitStatusesReadAt">
                    @if (Model.StatusesReadUtc is { } readAt)
                    {
                        <span>Statuses below were read from the chain at <strong>@readAt.ToString("u")</strong>, by
                        the last build or check. They do not update on their own.</span>
                    }
                    else
                    {
                        <span>When the statuses below were last read from the chain was not recorded. Press
                        <em>Check progress</em> to refresh them before acting on them.</span>
                    }
                </p>

                <div class="alert alert-warning" role="alert" id="SparkExitBroadcastOrder">
                    <p>
                        <strong>Follow the Status column.</strong> Every row tells you whether it may go out yet,
                        and a row that says Ready is safe to broadcast — sending one that has already been sent
                        is harmless, so you do not have to remember what you pushed. The order below is what the
                        dependencies mean, and the table is already sorted to satisfy it.
                    </p>
                    <p>
                        <strong>The unilateral steps need a node that can accept packages</strong> —
                        <code>bitcoin-cli submitpackage</code>, on <strong>Bitcoin Core 29 or later</strong>. A
                        plain <code>sendrawtransaction</code> rejects the tree transactions: they pay zero fee on
                        their own and are only acceptable together with the child that funds them. Each also
                        carries a zero-value pay-to-anchor (P2A) output for that child to spend, and older nodes
                        refuse to relay those, so a package that fails with a dust or standardness error on an older
                        node is not a broken exit — it needs a newer node.
                    </p>
                    <p>
                        <strong>Check this page every few hours while steps are becoming valid, not once a
                        day.</strong> Roughly 50 blocks — about eight hours — after a step becomes valid, a second
                        version of that same step becomes valid too. Spark's watchtowers hold it as a safety net for a wallet that goes offline
                        part-way through, and they can send it once it unlocks. Both versions move the same
                        money to the same place; they differ only in who pays the mining fee. The version this
                        plugin builds is paid for by the funding UTXO, at the rate you were quoted. The
                        watchtower's version has its fee built in and takes it out of the leaf, so it comes off
                        what arrives at your destination, at a rate you have no say in. <strong>A step left
                        unbroadcast for more than about eight hours after it became ready can therefore end up
                        paying for parts of itself out of the money it is recovering.</strong> The statuses on this
                        page do not update on their own — press <em>Check progress</em> to refresh them.
                    </p>
                    <ol class="mb-0">
                        <li>
                            Broadcast the <strong>fan-out</strong> first, on its own, and
                            <strong>wait for it to confirm</strong>. Every other fee in the exit comes out of its
                            outputs.
                        </li>
                        <li>
                            Then the <strong>tree-node packages</strong>, one at a time per branch, in the order
                            given by each transaction's <em>depends on</em> column. Submit the parent and its
                            child together as one package and wait for that package to confirm before the next
                            one on the same branch.
                        </li>
                        <li>
                            <strong>Later steps wait for their timelocks.</strong> A row whose status says it is
                            waiting is not ready yet — the Status column names the block it becomes valid at, and
                            those are the steps the watchtower warning above applies to.
                        </li>
                        <li>
                            The <strong>sweep</strong> goes last and alone, once everything it depends on has
                            confirmed. That is the transaction that pays your destination address.
                        </li>
                    </ol>
                    @if (Model.Transactions.Any(tx => tx.Kind is SparkExitTxKind.Cooperative))
                    {
                        @*
                            The order above is the unilateral exit's, and a cooperative recovery is outside it in
                            every respect — it has no fan-out to wait for, no child, no timelock and no dependency.
                            Said explicitly, because an operator reading a numbered list of four steps and then
                            seeing a fifth kind of row would otherwise place it somewhere in that list and wait for
                            a confirmation it does not need. A set can hold both kinds: the SDK chooses per leaf
                            from what the operators already put on-chain.
                        *@
                        <p class="mt-3 mb-0">
                            <strong>A cooperative recovery is not a step in that order.</strong> A row labelled
                            <em>cooperative recovery</em> is one transaction for one leaf the Spark operators already
                            moved on-chain: it pays its own fee out of the value it recovers, carries no fee-bumping
                            child and no timelock, and depends on nothing, so it can be broadcast alone as soon as
                            its status says ready — through any node, including one too old to accept packages.
                            Nothing in this set waits on it.
                        </p>
                    }
                </div>

                @if (Model.FailedLeaves is { Count: > 0 } failedLeaves)
                {
                    @*
                        A warning beside the set, not an error instead of it. A cooperative recovery is co-signed
                        leaf by leaf, so one the operators refuse does not fail the build: Spark builds the rest
                        and lists the refusal here. Rendered as a failure, an operator would rebuild a set that is
                        already complete, or abandon an exit whose transactions are still good — so the copy says
                        what is true instead: the set below recovers everything except these leaves, and each of
                        these needs an attempt of its own.
                    *@
                    <div class="alert alert-warning" role="alert" id="SparkExitFailedLeaves">
                        <p>
                            <strong>@failedLeaves.Count.ToString("N0") leaf(s) were left out of this build.</strong>
                            The Spark operators would not co-sign their recovery, so they are not among the
                            transactions below. Nothing below is incomplete because of it: the set is a complete
                            recovery of every other leaf, and it does not need rebuilding on this account.
                        </p>
                        <p class="mb-2">
                            Each of these leaves needs an attempt of its own, later — this exit is pinned to the
                            leaves it was quoted for, so a fresh quote for them waits until this one is finished or
                            abandoned.
                        </p>
                        <ul class="mb-0">
                            @foreach (var failedLeaf in failedLeaves)
                            {
                                <li class="mb-2">
                                    <vc:truncate-center text="@failedLeaf.LeafId" classes="truncate-center-id" />
                                    <div class="form-text">@failedLeaf.Reason</div>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.TransactionsUnreadable)
                {
                    <div class="alert alert-danger" role="alert" id="SparkExitTransactionsUnreadable">
                        <strong>This exit's transactions could not be read back.</strong>
                        The record says it was built, so the signed hex is stored, but this page could not decode
                        it — the server log has the detail. <strong>Do not abandon this exit</strong> while the
                        funding is still committed to it: build again first, which re-reads the chain and writes a
                        fresh set over the unreadable one.
                    </div>

                    @*
                        Building again is offered here precisely because the copy above says not to abandon. A
                        state whose only button is the one action its own warning forbids is a dead end, and an
                        operator in a dead end presses the forbidden button.
                    *@
                    <form method="post" asp-action="BuildExit" asp-route-storeId="@Model.StoreId"
                          permission="@Policies.CanModifyStoreSettings">
                        <input type="hidden" name="recordId" value="@record.Id" />
                        <button type="submit" class="btn btn-primary" id="SparkExitRebuildUnreadable">
                            Build again
                        </button>
                        <div class="form-text">
                            Prices this exit's own leaves again, hands Spark the funding this exit already
                            committed plus anything new on the funding address, signs, and replaces the stored set.
                            <strong>It broadcasts nothing</strong> and anything already broadcast and confirmed is
                            skipped rather than rebuilt.
                        </div>
                    </form>
                }
                else if (Model.Transactions.Count == 0)
                {
                    <div class="alert alert-warning" role="alert" id="SparkExitTransactionsEmpty">
                        <strong>The last build returned no transactions.</strong> Spark found nothing left to sign
                        for this exit's leaves, so there is nothing on this page to broadcast. If the sweep of an
                        earlier set has already confirmed, the exit is finished and you can mark it completed below.
                        Otherwise build again: it re-reads the chain and signs whatever is still outstanding.
                    </div>

                    <form method="post" asp-action="BuildExit" asp-route-storeId="@Model.StoreId"
                          permission="@Policies.CanModifyStoreSettings">
                        <input type="hidden" name="recordId" value="@record.Id" />
                        <button type="submit" class="btn btn-primary" id="SparkExitRebuildEmpty">
                            Build again
                        </button>
                        <div class="form-text">
                            Prices this exit's leaves again against the funding it already committed plus anything
                            new on its address, and signs the transactions. It broadcasts nothing.
                        </div>
                    </form>
                }
                else
                {
                    @*
                        Everything from here down is signed, broadcastable Bitcoin transactions. A store role that
                        can only view settings has no business holding them: the hex is enough to move this
                        store's balance to the destination already baked into it, so it is scoped to the same
                        permission the build itself is, not to whoever can read the page.
                    *@
                    <div class="alert alert-secondary" role="alert" id="SparkExitTransactionsRestricted"
                         not-permission="@Policies.CanModifyStoreSettings">
                        <strong>@Model.Transactions.Count.ToString("N0") transactions are built and waiting to be
                        broadcast.</strong>
                        The signed hex is not shown to view-only access, because it is enough on its own to move
                        this store's balance. Ask someone who can modify this store's settings.
                    </div>

                    <div permission="@Policies.CanModifyStoreSettings">
                        @*
                            The actionable slice of the table below, first. A built exit runs to a dozen rows
                            and at most one or two are ever sendable at a time, so an operator who opens this
                            page a day later should not have to read the whole set to find the row that matters.
                            This is a filter, not a second exit: the same transactions, the same
                            BroadcastCommand, read off the same model.
                        *@
                        @if (Model.PendingBroadcast is { Count: > 0 } pending)
                        {
                            <h4 class="mt-4 mb-2">Send these now</h4>
                            <div class="alert alert-info" role="alert" id="SparkExitPendingBroadcast">
                                <p class="mb-2">
                                    <strong>@pending.Count.ToString("N0") of these transactions can be broadcast
                                    right now.</strong> The rest are waiting on one of them to confirm — check
                                    this page again after each one lands.
                                </p>
                                <ul class="mb-0">
                                    @foreach (var ready in pending)
                                    {
                                        <li class="mb-2">
                                            <span>@DescribeKind(ready.Kind)</span>
                                            <div class="d-flex align-items-start gap-2 mt-1">
                                                <code class="text-break flex-grow-1">@BroadcastCommand(ready)</code>
                                                <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                                        data-clipboard-text="@BroadcastCommand(ready)">
                                                    Copy
                                                </button>
                                            </div>
                                            <div class="form-text">
                                                <vc:truncate-center text="@ready.Txid" classes="truncate-center-id" />
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <table class="table" id="SparkExitTransactions">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Kind</th>
                                    <th>Status</th>
                                    <th>Txid</th>
                                    <th class="text-end">CSV</th>
                                    <th>Depends on</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Transactions.Count; i++)
                                {
                                    var tx = Model.Transactions[i];
                                    var step = i + 1;
                                    <tr>
                                        <td>@step</td>
                                        <td>
                                            @DescribeKind(tx.Kind)
                                            @if (tx.NodeId is { } nodeId)
                                            {
                                                <div class="form-text">
                                                    <vc:truncate-center text="@nodeId" classes="truncate-center-id" />
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @DescribeTxStatus(tx.Status)
                                            @if (tx.Status.Readiness is SparkExitTxReadiness.Unverified)
                                            {
                                                <div class="form-text">
                                                    No chain service answered. Check it yourself before treating it as
                                                    either. If it stays unverified, build this exit again once your
                                                    chain service is healthy — the SDK's own guidance for this case,
                                                    because a rebuild re-reads the chain rather than guessing.
                                                </div>
                                            }
                                        </td>
                                        <td><vc:truncate-center text="@tx.Txid" classes="truncate-center-id" /></td>
                                        <td class="text-end">
                                            @if (tx.CsvTimelockBlocks is { } csv)
                                            {
                                                <span>@csv.ToString("N0")</span>
                                                <div class="form-text">blocks</div>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (tx.DependsOn.Count == 0)
                                            {
                                                <span class="text-secondary">Nothing</span>
                                            }
                                            else
                                            {
                                                foreach (var parent in tx.DependsOn)
                                                {
                                                    <vc:truncate-center text="@parent" classes="truncate-center-id" />
                                                }
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="6" class="pt-0">
                                            <details>
                                                <summary>Step @step — what to run</summary>
                                                @if (tx.CpfpTxHex is { } cpfpTxHex)
                                                {
                                                    <p class="form-text mt-2 mb-1">
                                                        <strong>A package.</strong> This transaction pays no fee of
                                                        its own; the second hex is the child that pays for it, and the
                                                        two are only valid submitted together.
                                                    </p>
                                                    <div class="d-flex align-items-start gap-2 mb-2">
                                                        @*
                                                            The command comes from BroadcastCommand rather than being
                                                            spelled out here, because the "send these now" list above
                                                            renders the same decision for the same row. Two copies
                                                            would be two chances to disagree about when a package is
                                                            required, and the merchant runs whichever one they read
                                                            first.
                                                        *@
                                                        <code class="text-break flex-grow-1" id="SparkExitPackage@step">@BroadcastCommand(tx)</code>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                                                data-clipboard-target="#SparkExitPackage@step">
                                                            Copy
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="form-text mt-2 mb-1">
                                                        <strong>Broadcasts alone.</strong> This one pays its own fee
                                                        and must not be submitted alongside anything else.
                                                        @if (tx.Kind is SparkExitTxKind.Cooperative)
                                                        {
                                                            <text>
                                                                It recovers a leaf the Spark operators already moved
                                                                on-chain and pays for itself out of the value it
                                                                recovers, so any node will take it — not only one
                                                                that accepts packages — and nothing else in this set
                                                                waits on it. Send it as soon as its status says
                                                                ready.
                                                            </text>
                                                        }
                                                    </p>
                                                    <div class="d-flex align-items-start gap-2 mb-2">
                                                        <code class="text-break flex-grow-1" id="SparkExitPackage@step">@BroadcastCommand(tx)</code>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                                                data-clipboard-target="#SparkExitPackage@step">
                                                            Copy
                                                        </button>
                                                    </div>
                                                }
                                                <div class="d-flex align-items-start gap-2">
                                                    <code class="text-break flex-grow-1" id="SparkExitTxHex@step">@tx.TxHex</code>
                                                    <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                                            data-clipboard-target="#SparkExitTxHex@step">
                                                        Copy hex
                                                    </button>
                                                </div>
                                                @if (tx.CpfpTxHex is { } childHex)
                                                {
                                                    <div class="d-flex align-items-start gap-2 mt-2">
                                                        <code class="text-break flex-grow-1" id="SparkExitCpfpHex@step">@childHex</code>
                                                        <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap"
                                                                data-clipboard-target="#SparkExitCpfpHex@step">
                                                            Copy child hex
                                                        </button>
                                                    </div>
                                                }
                                            </details>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @*
                            The fee bump. The SDK's only way to raise the fee on an exit that stopped confirming is
                            to quote again at a higher rate and build again, so the rate is an input here and not
                            only a figure in the summary. The browser's min is the built rate because a replacement
                            has to pay more than what it replaces; the service enforces the same rule.
                        *@
                        <form method="post" asp-action="BuildExit" asp-route-storeId="@Model.StoreId"
                              id="SparkExitRebuildForm" class="mt-3">
                            <input type="hidden" name="recordId" value="@record.Id" />
                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label for="SparkExitRebuildFeeRate" class="form-label">Fee rate for the rebuild</label>
                                    <div class="input-group">
                                        <input type="number" name="feeRateSatPerVbyte" id="SparkExitRebuildFeeRate"
                                               class="form-control" step="1"
                                               value="@record.FeeRateSatPerVbyte"
                                               min="@record.FeeRateSatPerVbyte"
                                               max="@SparkUnilateralExitService.MaxFeeRateSatPerVbyte" />
                                        <span class="input-group-text">sat/vB</span>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-secondary" id="SparkExitRebuild">
                                Build again
                            </button>
                            <div class="form-text">
                                At the same rate, this is the rebuild a Redo or an unverified status asks for. At a
                                higher rate it is how you raise the fee on an exit that has stopped confirming —
                                sending more funding alone changes nothing, because every transaction pays the rate
                                it was signed at. Steps already confirmed stay as they are; everything not yet
                                confirmed is signed again at the new rate, and the new fan-out, fee-bumping children
                                and sweep replace their earlier versions in the mempool once you broadcast them
                                (the tree transactions are pre-signed and do not change). The rebuild pays from the
                                funding this exit already committed; if a higher rate needs more, it says how much
                                to send to the funding address. It can only go up from the rate this set was built
                                at, and it broadcasts nothing.
                            </div>
                        </form>
                    </div>
                }

                @*
                    The check-in sits outside the branches above on purpose. It is the only control that reports
                    progress rather than asking for an action, and it is the one thing an operator wants in
                    *every* built state — including the empty and unreadable ones, where "what does the chain
                    say about this record" is the question they actually have. It posts rather than being a
                    link because it re-reads the chain and rewrites the stored statuses. It is not hidden when
                    the wallet is stopped — the service refuses with a reason that says to start it — because the
                    SDK's check, though it reads only the chain, is made through the running wallet.
                *@
                <div permission="@Policies.CanModifyStoreSettings">
                    <form method="post" asp-action="CheckExit" asp-route-storeId="@Model.StoreId"
                          id="SparkExitCheckForm" class="mt-3">
                        <input type="hidden" name="recordId" value="@record.Id" />
                        <button type="submit" class="btn btn-secondary" id="SparkExitCheck">
                            Check progress
                        </button>
                        <div class="form-text">
                            Asks the chain how far this exit has got and updates every status above.
                            <strong>It broadcasts nothing and signs nothing</strong>, so it is safe to press as
                            often as you like. It needs this store's Spark wallet running — the check goes
                            through the wallet's connection to the chain — though the transactions themselves do
                            not. Press it after each broadcast and every few hours while steps are maturing: a
                            step left unsent for more than about eight hours after it became ready can start
                            paying its own fee out of the money it is recovering.
                        </div>
                    </form>
                </div>

                @*
                    The exit's own ending. Nothing watches the chain between presses, so the plugin does not notice
                    on its own that the sweep confirmed — without this button the only way a finished exit leaves
                    the active state is "abandon", and telling a merchant to abandon the thing that just worked is
                    how a page teaches them to distrust it. The button asks Spark's check first.
                *@
                <div permission="@Policies.CanModifyStoreSettings">
                    <h3 class="mt-5 mb-3">When it is done</h3>
                    <form method="post" asp-action="CompleteExit" asp-route-storeId="@Model.StoreId">
                        <input type="hidden" name="recordId" value="@record.Id" />
                        <div class="form-check mb-2">
                            @*
                                The override, and deliberately not pre-ticked: completing takes the signed set off
                                this page, so the default is to complete only when Spark's own check says Done.
                            *@
                            <input type="checkbox" class="form-check-input" name="confirmedWithoutVerdict"
                                   value="true" id="SparkExitCompleteConfirmed" />
                            <label class="form-check-label" for="SparkExitCompleteConfirmed">
                                I have confirmed myself that the sweep is in a block — complete it without a check
                            </label>
                        </div>
                        <button type="submit" class="btn btn-outline-success" id="SparkExitComplete">
                            Mark this exit completed
                        </button>
                        <div class="form-text">
                            Asks Spark to check the chain first, and completes the exit only if every transaction
                            in this set is in a block — completing takes these transactions off this page, so
                            doing it early hides the steps still to send. Tick the box only when a check cannot
                            answer (the wallet will not start, or no chain service responds) and you have seen the
                            last of them confirm yourself. <strong>It moves nothing and broadcasts nothing</strong>, and
                            it frees this store to quote another exit.
                        </div>
                    </form>
                </div>
            }

            <div permission="@Policies.CanModifyStoreSettings">
                <h3 class="mt-5 mb-3">Abandon</h3>
                <div id="danger-zone" class="mb-5 mt-2">
                    <form method="post" asp-action="AbandonExit" asp-route-storeId="@Model.StoreId">
                        <input type="hidden" name="recordId" value="@record.Id" />
                        <button type="submit" class="btn btn-outline-danger" id="SparkExitAbandon">
                            Abandon this exit
                        </button>
                        <div class="form-text">
                            Frees this store to quote a new exit. <strong>It cancels nothing.</strong> Any
                            transaction you have already broadcast stays valid and will still confirm, and the
                            funding you sent is not returned — whatever part of it the broadcast transactions have
                            not spent on fees stays on the funding address, spendable from this store's recovery
                            phrase at the derivation path shown above.
                            @if (Model.TransactionsUnreadable)
                            {
                                <span class="d-block mt-1">
                                    <strong>This exit's transactions could not be read.</strong> Abandoning it
                                    does not undo anything that was signed, and the signed set stays stored:
                                    build again first if you have not already, so you can see what exists before
                                    you set this record aside.
                                </span>
                            }
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.History.Count > 0)
        {
            <h3 class="mt-5 mb-3">Earlier exits</h3>
            <table class="table" id="SparkExitHistory">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Quoted</th>
                        <th>Destination</th>
                        <th class="text-end">Recoverable</th>
                        <th class="text-end">Fee</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var past in Model.History)
                    {
                        <tr>
                            <td>@past.Status</td>
                            <td>@past.CreatedUtc.ToString("u")</td>
                            <td><vc:truncate-center text="@past.DestinationAddress" classes="truncate-center-id" /></td>
                            <td class="text-end">@past.RecoverableValueSat.ToString("N0") sats</td>
                            <td class="text-end">@past.TotalFeeSat.ToString("N0") sats</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        }
    </div>
</div>

@section PageFootContent {
    <partial name="_ValidationScriptsPartial" />
}
