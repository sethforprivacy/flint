@using BTCPayServer.Plugins.Flint.Payments
@model BTCPayServer.Models.InvoicingModels.CheckoutModel
@*
    Injected at "checkout-end": the checkout body for the USDC and USDT payment methods.

    Rendered only when this invoice offers one of them, so every other checkout on the server carries none of it.
    One component serves both coins, reading its data from model.flintStablecoin (StablecoinCheckoutModelExtension).

    The flow is one picker and one call. The payer chooses the network they hold the coin on, the component posts
    that to the plugin's quote endpoint, and the quote comes back as the address, the exact amount, and a QR code.
    The response is shown at once; the invoice's own status poll then carries the same quote in the model, which
    is what survives a reload.

    Vue event bindings are written v-on: rather than @, which Razor would read as code.
*@
@{
    var offersStablecoin = Model?.AvailablePaymentMethods?.Any(pm => StablecoinPayments.For(pm.PaymentMethodId) is not null) is true;
}
@if (offersStablecoin)
{
    <template id="@StablecoinCheckoutModelExtension.CheckoutBodyComponentName">
        <div class="payment-box" id="FlintStablecoinCheckout">
            <div v-if="networks.length === 0" class="alert alert-warning" role="alert" id="FlintStablecoinUnavailable">
                {{ asset }} payments are unavailable for this invoice right now. Please pay another way.
            </div>
            <div v-else class="form-group mb-3">
                <label class="form-label" for="FlintStablecoinNetwork">{{ asset }} network</label>
                <select id="FlintStablecoinNetwork" class="form-select" v-model="chain" v-on:change="requestQuote" :disabled="loading">
                    <option value="" disabled>Choose the network you are paying from</option>
                    <option v-for="network in networks" :key="network.chain" :value="network.chain">{{ network.name }}</option>
                </select>
            </div>

            <div v-if="loading" class="text-center text-secondary py-4">
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span class="ms-2">Getting a quote…</span>
            </div>

            <div v-else-if="error" class="alert alert-danger" role="alert" id="FlintStablecoinError">{{ error }}</div>

            <template v-else-if="quote">
                <div class="qr-container clipboard-button" :data-qr-value="quote.paymentRequest" :data-clipboard="quote.paymentRequest" data-clipboard-confirm-element="#FlintStablecoinAddress [data-clipboard]">
                    <div>
                        <qrcode :value="quote.paymentRequest" tag="div" :options="qrOptions" />
                    </div>
                </div>
                <div class="input-group mt-3">
                    <div class="form-floating" id="FlintStablecoinAmount">
                        <vc:truncate-center text="quote.amount" is-vue="true" padding="15" elastic="true" classes="form-control-plaintext" />
                        <label>Send exactly ({{ asset }})</label>
                    </div>
                </div>
                <div class="input-group mt-3">
                    <div class="form-floating" id="FlintStablecoinAddress">
                        <vc:truncate-center text="quote.address" is-vue="true" padding="15" elastic="true" classes="form-control-plaintext" />
                        <label>{{ asset }} address on {{ quote.chainName }}</label>
                    </div>
                </div>
                <p class="text-secondary small mt-3 mb-2" id="FlintStablecoinInstructions">
                    Send exactly this amount of {{ asset }} on {{ quote.chainName }}, in one transaction. Any other
                    token or network sent here is lost.
                </p>
                <p v-if="quote.contract" class="text-secondary small mb-2 text-break" id="FlintStablecoinContract">
                    Token contract: <span class="font-monospace">{{ quote.contract }}</span>
                </p>
                <p v-if="expired" class="text-warning small mb-2" id="FlintStablecoinExpired">
                    This quote has expired.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" v-on:click="requestQuote">Get a fresh one</button>
                    before you send.
                </p>
                <p class="text-secondary small mb-0">
                    It can take a few minutes after you send for the payment to show here.
                </p>
                <a v-if="isWalletLink && model.showPayInWalletButton" class="btn btn-primary rounded-pill w-100 mt-4" id="FlintStablecoinPayInWallet" target="_blank" rel="noreferrer noopener" :href="quote.paymentRequest">Pay in wallet</a>
            </template>
        </div>
    </template>

    <script>
        Vue.component(@Safe.Json(StablecoinCheckoutModelExtension.CheckoutBodyComponentName), {
            props: ['model', 'nfcSupported', 'nfcScanning', 'nfcErrorMessage', 'nfcWarningMessage'],
            template: @Safe.Json("#" + StablecoinCheckoutModelExtension.CheckoutBodyComponentName),
            components: {
                qrcode: VueQrcode
            },
            data () {
                return {
                    chain: '',
                    loading: false,
                    error: null,
                    localQuote: null,
                    now: Math.floor(Date.now() / 1000),
                    timer: null
                };
            },
            computed: {
                data () {
                    return this.model[@Safe.Json(StablecoinCheckoutModelExtension.ModelKey)] || { networks: [] };
                },
                asset () {
                    return this.data.asset || '';
                },
                networks () {
                    return this.data.networks || [];
                },
                quote () {
                    // The invoice's own quote once the status poll carries it; the one just requested until then.
                    const shown = this.data.quote;
                    if (shown && (!this.chain || shown.chain === this.chain))
                        return shown;
                    return this.localQuote && this.localQuote.chain === this.chain ? this.localQuote : null;
                },
                expired () {
                    return !!this.quote && this.quote.expiresAt < this.now;
                },
                isWalletLink () {
                    return !!this.quote && this.quote.paymentRequest.indexOf(':') !== -1;
                }
            },
            watch: {
                // One component serves USDC and USDT, so switching between them must not carry a network or a
                // quote across.
                'model.paymentMethodId' () {
                    this.chain = this.data.quote ? this.data.quote.chain : '';
                    this.localQuote = null;
                    this.error = null;
                }
            },
            mounted () {
                if (this.data.quote) {
                    this.chain = this.data.quote.chain;
                } else if (this.networks.length === 1) {
                    // Nothing to choose, so there is nothing to wait for either.
                    this.chain = this.networks[0].chain;
                    this.requestQuote();
                }
                this.timer = setInterval(() => { this.now = Math.floor(Date.now() / 1000); }, 5000);
            },
            beforeDestroy () {
                if (this.timer)
                    clearInterval(this.timer);
            },
            methods: {
                async requestQuote (event) {
                    // Read from the select itself when it fired this, so the order of v-model's own listener and
                    // this one cannot matter.
                    const picked = event && event.target && event.target.tagName === 'SELECT' ? event.target.value : null;
                    if (picked)
                        this.chain = picked;
                    if (!this.chain || !this.data.quoteUrl)
                        return;
                    this.loading = true;
                    this.error = null;
                    try {
                        const response = await fetch(this.data.quoteUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ chain: this.chain })
                        });
                        const body = await response.json().catch(() => ({}));
                        if (response.ok && body.quote) {
                            this.localQuote = body.quote;
                        } else {
                            this.localQuote = null;
                            this.error = body.error || 'This network cannot take the payment right now. Try another.';
                        }
                    } catch (e) {
                        this.localQuote = null;
                        this.error = 'Could not reach the store to get a quote. Check your connection and try again.';
                    } finally {
                        this.loading = false;
                    }
                }
            }
        });
    </script>
}
