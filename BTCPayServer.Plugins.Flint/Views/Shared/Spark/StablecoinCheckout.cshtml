@using BTCPayServer.Plugins.Flint.Payments
@using BTCPayServer.Plugins.Flint.Services
@model BTCPayServer.Models.InvoicingModels.CheckoutModel
@*
    Injected at "checkout-end": the checkout body for the USDC and USDT payment methods.

    Rendered only when this invoice offers one of them, so every other checkout on the server carries none of it.
    One component serves both coins, reading its data from model.flintStablecoin (StablecoinCheckoutModelExtension).

    The flow is one picker and one call. The payer chooses the network they hold the coin on, the component posts
    that to the plugin's quote endpoint, and the quote comes back as the address, the exact amount, and a QR code.
    The response is shown at once; the invoice's own status poll then carries the same quote in the model, which
    is what survives a reload.

    The network's icon is the payer's check that they are on the right network — the mistake that loses a payment
    outright — so it is on every network button, in the middle of the QR code, and on the address line. Only
    networks the plugin has an icon for are offered at all (StablecoinPayments.NetworkIcon). The token contract is
    behind "More details" and has no copy button: it is for checking the token in a wallet, and pasting it as the
    destination would burn the payment.

    Vue event bindings are written v-on: rather than @, which Razor would read as code.
*@
@{
    var offersStablecoin = Model?.AvailablePaymentMethods?.Any(pm => StablecoinPayments.For(pm.PaymentMethodId) is not null) is true;
    // Written once with the page rather than into the checkout model, which the status poll re-sends every few
    // seconds. BTCPay serves the plugin's embedded Resources/** from its web root.
    var networkIcons = StablecoinPayments.NetworkIconPaths.ToDictionary(pair => pair.Key, pair => Url.Content("~/" + pair.Value));
    var tokenIcons = StablecoinPayments.Assets.ToDictionary(asset => asset.Symbol, asset => Url.Content("~/" + StablecoinPayments.TokenIcon(asset)));
}
@if (offersStablecoin)
{
    <style>
        #FlintStablecoinCheckout .flint-networks {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--btcpay-space-s);
        }
        #FlintStablecoinCheckout .flint-network {
            display: flex;
            align-items: center;
            gap: var(--btcpay-space-s);
            text-align: start;
        }
        #FlintStablecoinCheckout .flint-network img,
        #FlintStablecoinCheckout .flint-network-chosen img {
            width: 24px;
            height: 24px;
            flex: none;
        }
        #FlintStablecoinCheckout .flint-network.active {
            border-color: var(--btcpay-primary);
            box-shadow: 0 0 0 1px var(--btcpay-primary);
        }
        #FlintStablecoinCheckout .flint-inline-icon {
            width: 1.25em;
            height: 1.25em;
            vertical-align: -.3em;
            margin-inline-end: .25em;
        }
        #FlintStablecoinCheckout details > summary {
            cursor: pointer;
        }
        /* The same size as the copy button truncate-center draws beside the address. */
        #FlintStablecoinAmount .clipboard-button {
            line-height: 1;
        }
        #FlintStablecoinAmount .clipboard-button .icon {
            --icon-size: 1em;
        }
    </style>

    @* The template's own id, distinct from the rendered box's, so the page never carries one id twice. *@
    <template id="@(StablecoinCheckoutModelExtension.CheckoutBodyComponentName)Template">
        <div class="payment-box" id="FlintStablecoinCheckout">
            <div v-if="networks.length === 0" class="alert alert-warning" role="alert" id="FlintStablecoinUnavailable">
                {{ asset }} payments are unavailable for this invoice right now. Please pay another way.
            </div>
            <template v-else>
                <div v-if="picking" class="mb-3" id="FlintStablecoinNetworks">
                    <p class="mb-2" id="FlintStablecoinNetworkPrompt">Which network are you sending {{ asset }} on?</p>
                    <div class="flint-networks" role="radiogroup" aria-labelledby="FlintStablecoinNetworkPrompt">
                        <button v-for="network in networks" :key="network.chain" type="button" role="radio"
                                class="btn btn-outline-secondary flint-network" :class="{ active: network.chain === chain }"
                                :aria-checked="network.chain === chain ? 'true' : 'false'" :disabled="loading"
                                :id="'FlintStablecoinNetwork-' + network.chain" v-on:click="pick(network.chain)">
                            <img v-if="iconFor(network.chain)" :src="iconFor(network.chain)" alt="" />
                            <span>{{ network.name }}</span>
                        </button>
                    </div>
                </div>
                <div v-else class="flint-network-chosen d-flex align-items-center justify-content-center gap-2 mb-3" id="FlintStablecoinNetworkChosen">
                    <img v-if="iconFor(chain)" :src="iconFor(chain)" alt="" />
                    <span>{{ asset }} on <strong>{{ chosenName }}</strong></span>
                    <button type="button" class="btn btn-link btn-sm p-0" id="FlintStablecoinChangeNetwork" :disabled="loading" v-on:click="choosing = true">Change</button>
                </div>
            </template>

            <div v-if="loading" class="text-center text-secondary py-4">
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span class="ms-2">Getting a quote…</span>
            </div>

            <div v-else-if="error && !picking" class="alert alert-danger" role="alert" id="FlintStablecoinError">{{ error }}</div>

            <template v-else-if="quote && !picking">
                <div class="qr-container clipboard-button" :data-qr-value="quote.paymentRequest" :data-clipboard="quote.paymentRequest" data-clipboard-confirm-element="#FlintStablecoinAddress [data-clipboard]">
                    <div>
                        <qrcode :value="quote.paymentRequest" tag="div" :options="qrOptions" />
                    </div>
                    <img v-if="iconFor(quote.chain)" class="qr-icon" :src="iconFor(quote.chain)" :alt="quote.chainName" id="FlintStablecoinQrIcon" />
                </div>
                <div class="input-group mt-3">
                    <div class="form-floating" id="FlintStablecoinAmount">
                        @* Not <vc:truncate-center>: its Vue variants show a string shorter than twice their padding
                           wrongly — the elastic one sliced "3.058956" to "3", and on BTCPay 2.4.3 the plain one
                           renders nothing. An amount is never long enough to need truncating anyway. *@
                        <div class="form-control-plaintext d-flex align-items-center gap-2">
                            <span id="FlintStablecoinAmountValue">{{ quote.amount }}</span>
                            <button type="button" class="btn btn-link p-0 clipboard-button" :data-clipboard="quote.amount" aria-label="Copy the amount">
                                <vc:icon symbol="actions-copy" />
                            </button>
                        </div>
                        <label><img v-if="tokenIcon" class="flint-inline-icon" :src="tokenIcon" alt="" />Send exactly ({{ asset }})</label>
                    </div>
                </div>
                <div class="input-group mt-3">
                    <div class="form-floating" id="FlintStablecoinAddress">
                        <vc:truncate-center text="quote.address" is-vue="true" padding="15" elastic="true" classes="form-control-plaintext" />
                        <label>{{ asset }} address on <img v-if="iconFor(quote.chain)" class="flint-inline-icon" :src="iconFor(quote.chain)" alt="" />{{ quote.chainName }}</label>
                    </div>
                </div>
                <p class="text-secondary small mt-3 mb-2" id="FlintStablecoinInstructions">
                    Send exactly this amount of {{ asset }} on {{ quote.chainName }}, in one transaction. Any other
                    token or network sent here is lost.
                </p>
                <details v-if="quote.contract" class="text-secondary small mb-2" id="FlintStablecoinMore">
                    <summary>More details</summary>
                    <p class="mt-2 mb-1">
                        The {{ asset }} token contract on {{ quote.chainName }}, for checking your wallet is sending the
                        right token. <strong>Never send anything to it</strong> — send to the address above.
                    </p>
                    <p class="font-monospace text-break mb-0" id="FlintStablecoinContract">{{ quote.contract }}</p>
                </details>
                <p v-if="expired" class="text-warning small mb-2" id="FlintStablecoinExpired">
                    This address is no longer offered.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" v-on:click="requestQuote">Get a fresh one</button>
                    before you send.
                </p>
                <p class="text-secondary small mb-0">
                    It can take a few minutes after you send for the payment to show here.
                </p>
                <a v-if="isWalletLink && model.showPayInWalletButton" class="btn btn-primary rounded-pill w-100 mt-4" id="FlintStablecoinPayInWallet" target="_blank" rel="noreferrer noopener" :href="quote.paymentRequest">Pay in wallet</a>
            </template>
        </div>
    </template>

    <script>
        (function () {
            const networkIcons = @Safe.Json(networkIcons);
            const tokenIcons = @Safe.Json(tokenIcons);

            Vue.component(@Safe.Json(StablecoinCheckoutModelExtension.CheckoutBodyComponentName), {
                props: ['model', 'nfcSupported', 'nfcScanning', 'nfcErrorMessage', 'nfcWarningMessage'],
                template: @Safe.Json("#" + StablecoinCheckoutModelExtension.CheckoutBodyComponentName + "Template"),
                components: {
                    qrcode: VueQrcode
                },
                data () {
                    return {
                        chain: '',
                        // True while the payer is choosing again after a network was already picked.
                        choosing: false,
                        loading: false,
                        error: null,
                        localQuote: null,
                        now: Math.floor(Date.now() / 1000),
                        timer: null
                    };
                },
                computed: {
                    data () {
                        return this.model[@Safe.Json(StablecoinCheckoutModelExtension.ModelKey)] || { networks: [] };
                    },
                    asset () {
                        return this.data.asset || '';
                    },
                    tokenIcon () {
                        return tokenIcons[this.asset] || null;
                    },
                    networks () {
                        return this.data.networks || [];
                    },
                    picking () {
                        return this.choosing || !this.chain;
                    },
                    chosenName () {
                        const network = this.networks.find(n => n.chain === this.chain);
                        return network ? network.name : this.chain;
                    },
                    quote () {
                        // The invoice's own quote once the status poll carries it; the one just requested until then.
                        const shown = this.data.quote;
                        if (shown && (!this.chain || shown.chain === this.chain))
                            return shown;
                        return this.localQuote && this.localQuote.chain === this.chain ? this.localQuote : null;
                    },
                    expired () {
                        return !!this.quote && this.quote.offeredUntil < this.now;
                    },
                    isWalletLink () {
                        return !!this.quote && this.quote.paymentRequest.indexOf(':') !== -1;
                    }
                },
                watch: {
                    // One component serves USDC and USDT, so switching between them must not carry a network or a
                    // quote across.
                    'model.paymentMethodId' () {
                        this.chain = this.data.quote ? this.data.quote.chain : '';
                        this.choosing = false;
                        this.localQuote = null;
                        this.error = null;
                    }
                },
                mounted () {
                    if (this.data.quote) {
                        this.chain = this.data.quote.chain;
                    } else if (this.networks.length === 1) {
                        // Nothing to choose, so there is nothing to wait for either.
                        this.pick(this.networks[0].chain);
                    }
                    this.timer = setInterval(() => { this.now = Math.floor(Date.now() / 1000); }, 5000);
                },
                beforeDestroy () {
                    if (this.timer)
                        clearInterval(this.timer);
                },
                methods: {
                    iconFor (chain) {
                        return chain ? networkIcons[String(chain).toLowerCase()] || null : null;
                    },
                    pick (chain) {
                        this.chain = chain;
                        this.choosing = false;
                        this.requestQuote();
                    },
                    async requestQuote () {
                        if (!this.chain || !this.data.quoteUrl)
                            return;
                        this.loading = true;
                        this.error = null;
                        try {
                            const response = await fetch(this.data.quoteUrl, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: new URLSearchParams({ chain: this.chain })
                            });
                            const body = await response.json().catch(() => ({}));
                            if (response.ok && body.quote) {
                                this.localQuote = body.quote;
                            } else {
                                this.localQuote = null;
                                this.error = body.error || 'This network cannot take the payment right now. Try another.';
                            }
                        } catch (e) {
                            this.localQuote = null;
                            this.error = 'Could not reach the store to get a quote. Check your connection and try again.';
                        } finally {
                            this.loading = false;
                        }
                    }
                }
            });
        })();
    </script>
}
